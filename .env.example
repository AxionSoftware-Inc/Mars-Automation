# Telegram Bot Token (@BotFather dan olinadi)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Excel fayl tashlanadigan kanal ID si (masalan: -1001234567890)
CHANNEL_ID=

# Odamlar so'rov yuboradigan guruh ID si (masalan: -1009876543210)
# Agar bo'sh qoldirilsa, bot qo'shilgan istalgan guruhda ishlaydi
GROUP_ID=

# Admin Telegram ID lari (vergul bilan ajratilgan, masalan: 12345678,87654321)
ADMINS=

# AI Vision & Reasoning API Key (OpenRouter yoki Google Gemini)
GEMINI_API_KEY=YOUR_API_KEY_HERE
